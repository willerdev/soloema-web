# Solo-api origin, no /api/v1 (Next server proxy)
API_URL=http://localhost:4001

# Used by a few client paths; production: https://<solo-api>.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1

